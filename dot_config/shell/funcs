#-------- gitag function {{{
gtag() {
  git status 2>& /dev/null
  if [ $? -ne 0 ]; then
    echo "Not in a git repo"
    return 1
  fi
  echo "Continue to tag with '$1' and push '$1' to origin?"
  select choice in "Yes" "No"; do
    case $choice in
      Yes ) git tag "$1" && git push origin "$1"; break;;
      No ) exit;;
    esac
  done
}
