pom() {
    local -r HOURS=${1:?}
    local -r MINUTES=${2:-0}
    local -r POMODORO_DURATION=${3:-25}

    echo "(($HOURS * 60) + $MINUTES) / $POMODORO_DURATION" | bc
}

