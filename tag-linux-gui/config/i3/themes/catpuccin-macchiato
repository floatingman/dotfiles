# Start i3bar to display a workspace bar (plus the system information i4status
# finds out, if available)
bar {
    status_command  py3status
    position        top
    colors {
        background         $bg0
        statusline         $fg
        focused_statusline $fg
        active_workspace   $bg0 $fg $blue
        focused_separator  $bg0
        focused_workspace  $bg0_hard $fg $green
        inactive_workspace $bg0 $bg0 $bg3
        urgent_workspace   $bg0 $bg0 $red
        binding_mode       $bg0 $bg0 $bg3
    }
}

# Window colors         Border  BG      Text    Indicator Child Border
client.focused           $aqua $bg0 $fg  $green $aqua
client.focused_inactive  $bg3 $bg0 $fg  $green $bg3
client.unfocused         $bg3 $bg0 $fg  $green $bg3
client.urgent            $red $bg0 $red $bg3  $red
client.placeholder       $bg3 $bg0 $fg  $bg3  $bg3
client.background        $bg0

# Gruvbox Dark colors
set $bg0_hard #1d2021
set $bg0      #282828
set $bg1      #3c3836
