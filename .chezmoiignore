# Ignore Linux-only desktop (WM/DE) configs unless this is a Linux machine
# flagged as a desktop. The flag lives in ~/.config/chezmoi/chezmoi.toml
# ([data.desktop] enabled), prompted once per machine by .chezmoi.toml.tmpl.
# The default-dict guards let machines whose config predates a section keep
# rendering (they keep the previous behavior until they answer the prompt).
{{- $desktopOn := eq (index (index . "desktop" | default (dict)) "enabled") true }}
{{- $piOn := eq (index (index . "pi" | default (dict)) "enabled") true }}
{{- if not (and (eq .chezmoi.os "linux") $desktopOn) }}
.config/i3
.config/i3blocks
.config/i3status
.config/rofi
.config/polybar
.config/dunst
.config/picom
.config/bspwm
.config/sxhkd
.config/swaylock
.config/fuzzel
.config/wofi
.config/waybar
.config/wlogout
.config/awesome
.config/hypr
.config/mpv
.config/cmus
.config/gammastep
.config/matugen
.config/viewnior
.config/zathura
.config/qutebrowser
.config/teiler
.config/youtube-dl
.config/yt-dlp
.config/autorandr
.Xresources.d
{{- end }}

# Ignore macOS configs on non-macOS systems
{{- if ne .chezmoi.os "darwin" }}
.config/karabiner
{{- end }}

# Development tools (not user dotfiles)
Makefile
scripts/

# Rendered by the my-configuration dotfiles role from asdf_plugins
# (group_vars/all/base.yml) — not a dotfiles-managed file.
.tool-versions

# Shared content backing symlink_ entries (not applied as targets)
files/

# pi-agent config — only applied where [data.pi].enabled is true (see .chezmoi.toml.tmpl).
# The install scripts clone pi-skills + pi-reviewer in place; settings.json/mcp.json
# are chezmoi-managed. Scripts skip gracefully if a repo isn't reachable.
{{- if not $piOn }}
.chezmoiscripts/run_once_install-pi-agent.sh.tmpl
.chezmoiscripts/run_once_install-pi-reviewer.sh.tmpl
.pi/agent/settings.json
.pi/agent/mcp.json
.pi/agent/AGENTS.md
{{- end }}

# omp managed-skills payload — synced into ~/.omp/agent/managed-skills by
# run_sync-omp-managed-skills.sh.tmpl, not applied as target files.
omp-managed-skills/

# herdr per-machine state — managed locally on each host, never synced
.local/state/herdr/client/endpoints.json
.local/state/herdr/client/endpoint-selection.json
.local/state/herdr/client/ssh-metadata/
