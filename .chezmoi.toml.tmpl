{{- /* Generates ~/.config/chezmoi/chezmoi.toml on `chezmoi init`.
      The merge placeholders below are escaped so they appear literally
      in the output (they are evaluated by chezmoi at merge time, not here).
      Only files named .chezmoi.<format>.tmpl are read by `chezmoi init`;
      a plain .chezmoi.toml in the source root is ignored. */ -}}

[merge]
  command = "nvim"
  args = [
    "-d",
    {{ `"{{ .Destination }}"` }},
    {{ `"{{ .Source }}"` }},
    {{ `"{{ .Target }}"` }}
  ]

[diff]
  exclude = ["scripts"]
  pager = "delta"

[add]
  templateSymlinks = true

[data]
  [data.anthropic]
    {{- /* Resolve the token at init time, in priority order:
          1. ANTHROPIC_AUTH_TOKEN env var (preferred, never committed)
          2. interactive prompt, cached in chezmoi's local state
             (~/.config/chezmoi/chezmoistate.boltdb, not in the repo)
          Defined here for reuse by any template needing an Anthropic token;
          no managed template currently consumes it. */ -}}
    {{- $token := env "ANTHROPIC_AUTH_TOKEN" | default (promptStringOnce . "anthropic.token" "Anthropic API token (leave blank to use ANTHROPIC_AUTH_TOKEN at runtime)" "") }}
    token = {{ $token | quote }}
  [data.claude]
    api_timeout_ms = "3000000"
  [data.pi]
    {{- /* Prompted once per machine (cached in chezmoistate.boltdb). When false, the
          pi-agent symlinks and clone script are ignored (see .chezmoiignore), so
          `chezmoi apply` leaves pi untouched on machines that don't use it. */ -}}
    {{- $piEnabled := promptBoolOnce . "pi.enabled" "Enable pi-agent config (skills + settings via ~/dotfiles) on this machine?" false }}
    enabled = {{ $piEnabled }}
