{{- /* Generates ~/.config/chezmoi/chezmoi.toml on `chezmoi init`.
      The merge placeholders below are escaped so they appear literally
      in the output (they are evaluated by chezmoi at merge time, not here).
      Only files named .chezmoi.<format>.tmpl are read by `chezmoi init`;
      a plain .chezmoi.toml in the source root is ignored. */ -}}

[merge]
  command = "nvim"
  args = [
    "-d",
    {{ `"{{ .Destination }}"` }},
    {{ `"{{ .Source }}"` }},
    {{ `"{{ .Target }}"` }}
  ]

[diff]
  exclude = ["scripts"]
  pager = "delta"

[add]
  templateSymlinks = true

[data]
  [data.pi]
    {{- /* Prompted once per machine (cached in chezmoistate.boltdb). When false, the
          pi-agent install script is ignored (see .chezmoiignore), so `chezmoi apply`
          leaves pi untouched on machines that don't use it. `repo` defaults to the
          maintainer's private pi-dotfiles; forkers override it with their own URL. */ -}}
    {{- $piEnabled := promptBoolOnce . "pi.enabled" "Enable pi-agent config (skills + settings via ~/dotfiles) on this machine?" false }}
    {{- $piRepo := promptStringOnce . "pi.repo" "pi-dotfiles repo URL (set to YOUR fork if you have one)" "git@github.com:floatingman/pi-dotfiles.git" }}
    {{- $piReviewerRepo := promptStringOnce . "pi.reviewerRepo" "pi-reviewer repo URL (your fork if you have one)" "git@github.com:floatingman/pi-reviewer.git" }}
    enabled = {{ $piEnabled }}
    repo = {{ $piRepo | quote }}
    reviewerRepo = {{ $piReviewerRepo | quote }}
