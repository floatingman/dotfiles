{{- /* Clones the pi skills repo into ~/.pi/agent/skills (in place) on machines where
      [data.pi].enabled is true, so pi reads skills from their consumption path.
      Probes the configured repo (data.pi.repo) and skips gracefully if unreachable
      (e.g. a forker without access), so chezmoi apply never breaks. The user
      edits/pushes directly in ~/.pi/agent/skills (a normal git checkout). */ -}}
{{- if .pi.enabled -}}
#!/usr/bin/env bash
set -u
TARGET="$HOME/.pi/agent/skills"
REPO="{{ .pi.repo | default "git@github.com:floatingman/pi-dotfiles.git" }}"

if [ -d "$TARGET/.git" ]; then
  echo "pi-skills: already present at $TARGET"
  exit 0
fi

mkdir -p "$HOME/.pi/agent"
printf 'pi-skills: probing %s ...\n' "$REPO"
if ! GIT_TERMINAL_PROMPT=0 git ls-remote --exit-code "$REPO" HEAD >/dev/null 2>&1; then
  cat <<EOF
pi-skills: cannot reach '$REPO' (private repo, no access, or wrong URL).
  Skipping — chezmoi apply continues. pi will have no global skills until you
  clone the skills repo to ~/.pi/agent/skills (or set [data.pi] repo to your
  fork and re-run: chezmoi init && chezmoi apply).
EOF
  exit 0
fi
printf 'pi-skills: cloning into %s ...\n' "$TARGET"
if ! GIT_TERMINAL_PROMPT=0 git clone --quiet "$REPO" "$TARGET"; then
  echo "pi-skills: clone failed; skipping."
fi
exit 0
{{- end }}
